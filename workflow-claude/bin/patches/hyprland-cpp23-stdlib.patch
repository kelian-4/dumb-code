+    auto rangeStartsWith = [](auto&& range, auto&& prefix) -> bool {
+        auto it = std::ranges::begin(range);
+        auto end = std::ranges::end(range);
+        auto pit = std::ranges::begin(prefix);
+        auto pend = std::ranges::end(prefix);
+        for (; pit != pend; ++pit, ++it) {
+            if (it == end || *it != *pit)
+                return false;
+        }
+        return true;
+    };
